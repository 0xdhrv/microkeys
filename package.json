{
  "name": "microkeys",
  "version": "0.1.0",
  "description": "A tiny, fast, type-safe keybinding library.",
  "keywords": [
    "hotkeys",
    "keybindings",
    "keyboard",
    "shortcuts",
    "typescript"
  ],
  "homepage": "https://microkeys.dhrv.pw",
  "bugs": {
    "url": "https://github.com/0xdhrv/microkeys/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xdhrv/microkeys.git"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:watch": "vp test",
    "bench": "pnpm build && node bench/dispatch.bench.mjs",
    "check": "vp check && vp test run && vp pack",
    "prepublishOnly": "pnpm check",
    "site:dev": "pnpm --filter microkeys-site dev",
    "site:build": "pnpm --filter microkeys-site build",
    "lint": "vp lint",
    "fmt": "vp fmt"
  },
  "devDependencies": {
    "happy-dom": "^21.0.3",
    "tinybench": "^6.2.2",
    "tinykeys": "^4.0.1",
    "typescript": "^7.0.2",
    "vite-plus": "1.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.14.0"
}
